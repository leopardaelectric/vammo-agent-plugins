{
  "description": "Two deterministic gates. Before git push: TruffleHog on the commits being pushed. Before a pull request (gh pr create, or a GitHub MCP create_pull_request tool): TruffleHog on the branch, then a claude-security scan of HEAD must exist, or Claude is told to run the pre-pr-security skill first.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/vammo_security.py\" hook",
            "timeout": 240
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/vammo_security.py\" hook",
            "timeout": 240
          }
        ]
      },
      {
        "matcher": "mcp__.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/vammo_security.py\" hook",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
