{
  "description": "Two deterministic gates. Before git push: TruffleHog on the commits being pushed. Before a pull request (gh pr create, a gh api POST to pulls, or a GitHub MCP create_pull_request tool): TruffleHog on the branch, then a claude-security scan of HEAD must exist, or Claude is told to run the pre-pr-security skill first. The `if` filters only decide when the script runs; the script itself decides whether the command pushes or opens a PR, and on which checkout.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/vammo_security.py\" hook",
            "timeout": 240
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/vammo_security.py\" hook",
            "timeout": 240
          },
          {
            "type": "command",
            "if": "Bash(git -C *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/vammo_security.py\" hook",
            "timeout": 240
          },
          {
            "type": "command",
            "if": "Bash(gh api *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/vammo_security.py\" hook",
            "timeout": 240
          },
          {
            "type": "command",
            "if": "Bash(python3 -c *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/vammo_security.py\" hook",
            "timeout": 240
          },
          {
            "type": "command",
            "if": "Bash(python -c *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/vammo_security.py\" hook",
            "timeout": 240
          },
          {
            "type": "command",
            "if": "Bash(node -e *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/vammo_security.py\" hook",
            "timeout": 240
          },
          {
            "type": "command",
            "if": "Bash(perl -e *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/vammo_security.py\" hook",
            "timeout": 240
          },
          {
            "type": "command",
            "if": "Bash(ruby -e *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/vammo_security.py\" hook",
            "timeout": 240
          }
        ]
      },
      {
        "matcher": "mcp__.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/vammo_security.py\" hook",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
